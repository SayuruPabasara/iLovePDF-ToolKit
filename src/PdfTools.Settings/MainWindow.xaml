<Window x:Class="PdfTools.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="iLovePDF Tools" Width="760" Height="560" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" Icon="app.ico">
    <Grid Margin="12">
        <TabControl x:Name="Tabs">

            <!-- ============================ SETTINGS ============================ -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">

                        <TextBlock Text="iLoveAPI key" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KeyStatus" Margin="0,6,0,0"/>

                        <TextBlock Text="Project public key" Margin="0,14,0,4"/>
                        <PasswordBox x:Name="KeyBox" Height="28" VerticalContentAlignment="Center"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Paste the project public key from your iLoveAPI console (API Keys). The secret key is not needed. Your key is stored encrypted for your Windows account only."/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button x:Name="SaveKeyButton" Content="Validate &amp; save key" Click="SaveKey_Click" IsDefault="True"/>
                            <Button x:Name="RemoveKeyButton" Content="Remove key" Margin="8,0,0,0" Click="RemoveKey_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="KeyMessage" Margin="0,8,0,0" TextWrapping="Wrap"/>

                        <TextBlock Margin="0,8,0,0">
                            <Hyperlink NavigateUri="https://www.iloveapi.com/signup" RequestNavigate="Link_Navigate">No keys yet? Create a free iLoveAPI account</Hyperlink>
                            <Run Text="  |  "/>
                            <Hyperlink NavigateUri="https://www.iloveapi.com/user/projects" RequestNavigate="Link_Navigate">Open my API keys</Hyperlink>
                        </TextBlock>

                        <Separator Margin="0,20,0,16"/>

                        <TextBlock Text="Options" FontSize="16" FontWeight="SemiBold"/>

                        <TextBlock Text="Compression level" Margin="0,12,0,4"/>
                        <ComboBox x:Name="CompressionBox" Width="260" HorizontalAlignment="Left"/>

                        <TextBlock Text="Processing region" Margin="0,12,0,4"/>
                        <ComboBox x:Name="RegionBox" Width="260" HorizontalAlignment="Left"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="Where your files are uploaded and processed. Automatic lets iLoveAPI choose."/>

                        <TextBlock Text="Keep activity log for (days)" Margin="0,12,0,4"/>
                        <TextBox x:Name="RetentionBox" Width="80" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save options" Click="SaveOptions_Click"/>
                            <TextBlock x:Name="OptionsMessage" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ LOG ============================ -->
            <TabItem Header="Activity log">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Refresh" Click="RefreshLog_Click"/>
                        <CheckBox x:Name="FailuresOnly" Content="Show failures only" Margin="12,0,0,0"
                                  VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
                        <Button Content="Open log folder" Margin="12,0,0,0" Click="OpenLogFolder_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="LogGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              SelectionMode="Single" AlternatingRowBackground="#F7F7F7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="140"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Operation}" Width="110"/>
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" Width="180"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ============================ ABOUT ============================ -->
            <TabItem Header="About">
                <StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock x:Name="AboutTitle" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Right-click a file in Explorer and choose &quot;Show more options&quot; to find the iLovePDF actions: Compress and Merge for PDFs, Convert to PDF for Word, PowerPoint and JPG files. Results are saved next to the original and never overwrite an existing file."/>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Text="Files are uploaded to iLoveAPI for processing and removed from their servers right after the result is downloaded. This app keeps no copy of your documents. The activity log records only action, file names, result and time."/>
                    <TextBlock x:Name="AboutPaths" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
